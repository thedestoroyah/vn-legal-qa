# LLM cho tác tử (API chuẩn OpenAI).
# Gemini free tier: gemini-3.1-flash-lite (15 RPM, 250k TPM, 500 RPD). Key lấy tại aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Giây tối thiểu giữa 2 lượt gọi thật: 60 / 15 RPM = 4 (+0.2 dự phòng)
LLM_MIN_INTERVAL=4.2

# LLM cho bộ chấm, nên khác nhà cung cấp với tác tử.
# Groq: JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=

# Embedding mặc định BAAI/bge-m3 chạy local. index.py KHÔNG đọc file này:
# muốn dùng OpenAI thì đặt 2 biến dưới trong shell (fish: set -x EMBED_MODEL text-embedding-3-small).
# EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
