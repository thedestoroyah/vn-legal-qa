# LLM cho tác tử (API chuẩn OpenAI).
# Gemini free tier: gemini-3.1-flash-lite (15 RPM, 250k TPM, 500 RPD). Key lấy tại aistudio.google.com
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Giây tối thiểu giữa 2 lượt gọi thật: 60 / 15 RPM = 4 (+0.2 dự phòng)
LLM_MIN_INTERVAL=4.2

# LLM cho bộ chấm, nên khác nhà cung cấp với tác tử.
# Groq: JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=openai/gpt-oss-120b
# Groq free tier gpt-oss-120b: 1000 RPD, 8000 TPM, 200k token/ngày (TPD, cửa sổ trượt 24h); mỗi lượt chấm ~1900 token → ~100 câu/ngày
JUDGE_MIN_INTERVAL=12

# Embedding mặc định BAAI/bge-m3 chạy local. index.py KHÔNG đọc file này:
# muốn dùng OpenAI thì đặt 2 biến dưới trong shell (fish: set -x EMBED_MODEL text-embedding-3-small).
# EMBED_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# Cấu hình giao diện NiceGUI (src/ui/web) kết nối FastAPI backend
API_URL=http://localhost:8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
API_TIMEOUT=180
# Đặt 0 để giao diện báo lỗi thay vì dùng dữ liệu dự phòng khi không nối được API (Docker đã đặt sẵn)
# UI_LOCAL_FALLBACK=0
