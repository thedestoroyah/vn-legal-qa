        <mxCell id="act_date_policy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=14;align=left;spacingLeft=8;" value="&lt;div&gt;Sử dụng luồng Retrieval mặc định&lt;/div&gt;Xác định ngày lọc hiệu lực (_query_date):&lt;br&gt;- event: event_date hoặc TODAY&lt;br&gt;- current: TODAY&lt;br&gt;- any: không lọc ngày (None)" vertex="1">
