<mxfile host="Electron" agent="draw.io"><diagram id="RAG một lượt" name="RAG một lượt"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1320" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:21px&quot;&gt;RAG MỘT LƯỢT (NAIVE RAG)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:15px&quot;&gt;Truy xuất một lần rồi sinh câu trả lời, theo một chiều&lt;/i&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1280" height="60" as="geometry"/></mxCell><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="44" y="24" width="44" height="44" as="geometry"/></mxCell><mxCell id="c3" value="NGOẠI TUYẾN: lập chỉ mục" style="swimlane;startSize=34;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#dfe3e8;swimlaneFillColor=#f6f7f9;strokeColor=#8a94a3;strokeWidth=1.5;fontColor=#3c4654;fontStyle=1;fontSize=15;fontFamily=Arial;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="1260" height="160" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:17px;color:#3c4654&quot;&gt;Kho văn bản&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8a94a3;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=top;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="270" height="95" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="179.0" y="149" width="32" height="32" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:17px;color:#3c4654&quot;&gt;Tách đoạn&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fi