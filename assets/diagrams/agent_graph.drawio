r&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;no_router&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;no_grading&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✗&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✓&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;no_verify&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✓&lt;/td&gt;&lt;td style=&quot;border:1px solid #9aa4b2;padding:3px 12px;text-align:center&quot;&gt;✗&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="700" width="330" height="150" as="geometry"/></mxCell><mxCell id="c38" value="Màu cạnh: xanh đậm luồng chính · cam vòng lặp · đỏ dẫn tới từ chối · nét đứt xám: cạnh chỉ có ở cấu hình tắt thành phần tương ứng. verify (a) chạy ở mọi cấu hình. Mỗi câu tình huống đi trọn luồng tốn khoảng 4 lượt LLM." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="1240" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
