;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8f4fc;strokeColor=#9673c4;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=top;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="160" y="420" width="290" height="100" as="geometry"/></mxCell><mxCell id="c13" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="289.0" y="429" width="32" height="32" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#1f3a5f;fontColor=#1f3a5f;" edge="1" parent="1" source="c4" target="c8"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#1f3a5f;fontColor=#1f3a5f;" edge="1" parent="1" source="c6" target="c10"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#1f3a5f;fontColor=#1f3a5f;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c8" target="c12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;fontFamily=Arial;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=10;strokeColor=#1f3a5f;fontColor=#1f3a5f;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c10" target="c12"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Nhanh: mỗi đoạn mã hóa một lần. Dùng để lấy ứng viên từ toàn kho." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontFamily=Arial;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="50" y="540" width="510" height="70" as="geometry"/></mxCell><mxCell id="c19" value="(b) CROSS-ENCODER: mã hóa chung" style="swimlane;startSize=34;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#fbd5bf;swimlaneFillColor=#fff5ef;strokeColor=#e07b39;strokeWidth=1.5;fontColor=#9a4512;fontStyle=1;fontSize=15;fontFamily=Arial;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="620" y="100" width="550" height="520" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b style=&quot;font-size:17px;color:#9a4512&quot;&gt;[CLS] q₁ … qₙ [SEP] d₁ … dₘ [SEP]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;ghép Q và D thành một chuỗi&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#e07b39;strokeWidth=1.5;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=52;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="510" height="90" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="654" y="179.0" width="32" height="32" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&quot;font-size:17px;color:#2e6b2a&quot;&gt;Transformer (BGE-Reranker-v2-M3)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;self-attention trên cả chuỗi: mỗi từ của Q&lt;br&gt;đối chiếu trực tiếp với từng từ của D&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f2faf0;strokeColor=#5aa155;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=top;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="640" y="265" width="510" height="120" as="geometry"/></mxCell><mxCell id="c23" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;