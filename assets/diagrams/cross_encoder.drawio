<mxfile host="Electron" agent="draw.io"><diagram id="Cross-encoder" name="Cross-encoder"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1200" pageHeight="680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:21px&quot;&gt;BI-ENCODER VÀ CROSS-ENCODER&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:15px&quot;&gt;Khác nhau ở thời điểm câu truy vấn và đoạn luật được cho tương tác&lt;/i&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1160" height="60" as="geometry"/></mxCell><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="44" y="24" width="44" height="44" as="geometry"/></mxCell><mxCell id="c3" value="(a) BI-ENCODER: mã hóa riêng" style="swimlane;startSize=34;rounded=1;arcSize=3;html=1;whiteSpace=wrap;fillColor=#cfe2f3;swimlaneFillColor=#f3f8fd;strokeColor=#4a86c5;strokeWidth=1.5;fontColor=#1f4e79;fontStyle=1;fontSize=15;fontFamily=Arial;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="550" height="520" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:17px;color:#1f4e79&quot;&gt;Truy vấn Q&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a86c5;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=top;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="245" height="90" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="156.5" y="159" width="32" height="32" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:17px;color:#1f4e79&quot;&gt;Đoạn luật D&lt;/b&gt;" style="rounded=1;arcSize=10;whi