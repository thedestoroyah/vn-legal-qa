<mxfile host="Electron" agent="draw.io"><diagram id="Bi-encoder" name="Bi-encoder"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1100" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b style=&quot;font-size:21px&quot;&gt;BI-ENCODER&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:15px&quot;&gt;Câu truy vấn và đoạn luật được mã hóa riêng, chỉ gặp nhau ở bước so sánh vector&lt;/i&gt;" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#1f3a5f;strokeColor=#1f3a5f;fontColor=#ffffff;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1060" height="60" as="geometry"/></mxCell><mxCell id="c2" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="44" y="24" width="44" height="44" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:17px;color:#1f4e79&quot;&gt;Câu truy vấn Q&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;“Nghỉ việc phải báo trước bao nhiêu ngày?”&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a86c5;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=top;spacingTop=44;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="400" height="100" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;html=1;imageAspect=0;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="264.0" y="119" width="32" height="32" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:17px;color:#1f4e79&quot;&gt;Đoạn luật D&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#333333&quot;&gt;BLLD2019_Dieu35_Khoan1: “Người lao động có quyền…”&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4a86c5;strokeWidth=1.5;fontFamily=Arial;align=center;verticalAlign=top;spacingTop=44;" v